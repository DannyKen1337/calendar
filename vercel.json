{
  "ignoreCommand": "[ -n \"$VERCEL_GIT_COMMIT_REF\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"master\" ]",
  "crons": [
    {
      "path": "/api/cron/cleanup",
